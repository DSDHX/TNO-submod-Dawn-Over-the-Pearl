		}
		containerWindowType = {
			name = construction_directory_scroll
			position = { x = 21 y = 104 }
			size = { width = 190 height = 491 }
			drag_scroll = { left middle }
			verticalScrollbar = "right_vertical_slider"
			vertical_scroll_step = 36
			scroll_wheel_factor = 36
			smooth_scrolling = yes
			margin = { top = 0 bottom = 0 left = 0 right = 18 }
			clipping = yes
			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window_transparent"
				position = { x = 0 y = 0 }
			}
			gridboxtype = {
				name = construction_directory_grid
				position = { x = -5 y = 0 }
				# The viewport owns the fixed height; the scripted scroll ensurer below
				# reports the dynamic list's real content extent to the parent.
				size = { width = 170 height = 100% }
				slotsize = { width = 170 height = 36 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
			# Scripted dynamic-list entries do not reliably expand a container's
			# scroll bounds. TNO's economy GUI uses the same invisible-child fix.
			# containerWindowType = {
			# 	name = DOP_construction_directory_scroll_ensurer
			# 	position = { x = 0 y = 528 }
			# 	size = { width = 1 height = 1 }
